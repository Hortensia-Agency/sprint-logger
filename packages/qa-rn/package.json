{
  "name": "@sprint-logger/qa-rn",
  "version": "0.7.3",
  "description": "Sprint QA widget for React Native / Expo host apps — in-context bug reporting and QA queue, authed via a mobile_widget PAT.",
  "keywords": [
    "qa",
    "bug-reporting",
    "sprint",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hortensia-Agency/sprint-logger.git",
    "directory": "packages/qa-rn"
  },
  "homepage": "https://github.com/Hortensia-Agency/sprint-logger/tree/main/packages/qa-rn#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "verify": "tsup && publint --strict",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "expo-audio": ">=0.3.0",
    "expo-av": ">=13.0.0",
    "expo-crypto": ">=13.0.0",
    "expo-file-system": ">=16.0.0",
    "expo-image-picker": ">=14.0.0",
    "expo-video": ">=1.0.0",
    "expo-web-browser": ">=13.0.0",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-nitro-screen-recorder": "*",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0",
    "react-native-view-shot": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "expo-audio": {
      "optional": true
    },
    "expo-av": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-video": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "react-native-nitro-screen-recorder": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "publint": "^0.2.12",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
